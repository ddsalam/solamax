model SaldoPelangganSnapshotManifest {
  unitId                       Int       @map("unit_id") @db.SmallInt
  asOfDate                     DateTime  @map("as_of_date") @db.Date
  generationId                 String    @map("generation_id") @db.Uuid
  formulaVersion               String    @map("formula_version")
  status                       String    @default("building")
  baseMonthEnd                 DateTime? @map("base_month_end") @db.Date
  baseGenerationId             String?   @map("base_generation_id") @db.Uuid
  sourceCycleId                String    @map("source_cycle_id") @db.Uuid
  sourceCycleSequence          BigInt    @map("source_cycle_sequence")
  sourceCycleStatus            String    @default("complete") @map("source_cycle_status")
  sourceCompletedAt            DateTime  @map("source_completed_at") @db.Timestamptz()
  rebuildEpoch                 BigInt    @default(0) @map("rebuild_epoch")
  startedAt                    DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  computedAt                   DateTime? @map("computed_at") @db.Timestamptz()
  completedAt                  DateTime? @map("completed_at") @db.Timestamptz()
  published                    Boolean   @default(false)
  publishedAt                  DateTime? @map("published_at") @db.Timestamptz()
  validationPassed             Boolean   @default(false) @map("validation_passed")
  customerKeyCount             BigInt?   @map("customer_key_count")
  rowCount                     BigInt?   @map("row_count")
  rowKeyedChecksum             Bytes?    @map("row_keyed_checksum")
  awalPiutangLokalTotal        Decimal?  @map("awal_piutang_lokal_total") @db.Decimal
  akhirPiutangLokalTotal       Decimal?  @map("akhir_piutang_lokal_total") @db.Decimal
  awalPiutangOnlineTotal       Decimal?  @map("awal_piutang_online_total") @db.Decimal
  akhirPiutangOnlineTotal      Decimal?  @map("akhir_piutang_online_total") @db.Decimal
  awalHutangLokalTotal         Decimal?  @map("awal_hutang_lokal_total") @db.Decimal
  akhirHutangLokalTotal        Decimal?  @map("akhir_hutang_lokal_total") @db.Decimal
  sourcePelangganRowCount      BigInt?   @map("source_pelanggan_row_count")
  sourcePelangganKeyedChecksum Bytes?    @map("source_pelanggan_keyed_checksum")
  sourceBppiutRowCount         BigInt?   @map("source_bppiut_row_count")
  sourceBppiutKeyedChecksum    Bytes?    @map("source_bppiut_keyed_checksum")
  sourceBphutRowCount          BigInt?   @map("source_bphut_row_count")
  sourceBphutKeyedChecksum     Bytes?    @map("source_bphut_keyed_checksum")
  failureCode                  String?   @map("failure_code")
  failureSummary               String?   @map("failure_summary")
  retryable                    Boolean   @default(false)

  @@id([unitId, asOfDate, generationId], map: "sps_manifest_pkey")
  @@unique([unitId, asOfDate, generationId, status, published, validationPassed, sourceCycleSequence, rebuildEpoch], map: "sps_manifest_pointer_target_key")
  @@unique([unitId, asOfDate, generationId, sourceCycleSequence], map: "sps_manifest_coverage_target_key")
  @@map("saldo_pelanggan_snapshot_manifest")
  @@schema("app")
}

