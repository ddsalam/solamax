model SaldoPelangganBuildWork {
  unitId              Int       @map("unit_id") @db.SmallInt
  workId              String    @map("work_id") @db.Uuid
  asOfDate            DateTime  @map("as_of_date") @db.Date
  sourceCycleId       String    @map("source_cycle_id") @db.Uuid
  sourceCycleSequence BigInt    @map("source_cycle_sequence")
  sourceCycleStatus   String    @default("complete") @map("source_cycle_status")
  rebuildEpoch        BigInt    @default(0) @map("rebuild_epoch")
  generationId        String?   @map("generation_id") @db.Uuid
  state               String    @default("queued")
  attemptCount        Int       @default(0) @map("attempt_count") @db.SmallInt
  availableAt         DateTime  @default(now()) @map("available_at") @db.Timestamptz()
  leaseOwner          String?   @map("lease_owner")
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz()
  heartbeatAt         DateTime? @map("heartbeat_at") @db.Timestamptz()
