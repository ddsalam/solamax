// Skema Cloud SQL Postgres — mirror ARCHITECTURE.md §3 (TERKUNCI by verifikasi
// 2026-06-11). Detail tanpa PRI di MySQL → surrogate id + UNIQUE natural key.

generator client {
  provider        = "prisma-client-js"
  // native = dev Mac; debian-openssl-3.0.x = node:22-slim (bookworm) di Cloud Run.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // public = mirror data EasyMax (read-only utk app); app = auth/kontrol RBAC.
  schemas  = ["app", "public"]
}

model Unit {
  unitId     Int      @id @map("unit_id") @db.SmallInt
  code       String   @unique
  name       String
  apiKeyHash String   @unique @map("api_key_hash")
  timezone   String   @default("Asia/Pontianak")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenantId   String   @map("tenant_id") @db.Uuid // pemilik SPBU (multi-tenant); WAJIB sejak 0019

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  userUnits UserUnit[]

  /// Target FK komposit dari app.user_unit (0019): mengunci keselarasan unit<->tenant.
  @@unique([unitId, tenantId])
  @@map("unit")
  @@schema("public")
}

model SyncState {
  unitId        Int       @map("unit_id") @db.SmallInt
  domain        String
  lastWatermark DateTime? @map("last_watermark") @db.Timestamptz()
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz()
  lastRowCount  Int?      @map("last_row_count")

  @@id([unitId, domain])
  @@map("sync_state")
  @@schema("public")
}

model SalesHeader {
  unitId     Int      @map("unit_id") @db.SmallInt
  ckdjualbbm String   @db.Char(15)
  dtgljual   DateTime @db.Date
  nshift     Int?     @db.SmallInt
  vcket      String?

  @@id([unitId, ckdjualbbm])
  @@index([unitId, dtgljual])
  @@map("sales_header")
  @@schema("public")
}

model SalesDetail {
  id          BigInt   @id @default(autoincrement())
  unitId      Int      @map("unit_id") @db.SmallInt
  ckdjualbbm  String   @db.Char(15)
  ckdnozzle   String   @db.Char(5)
  nurut       Int
  nstandawal  Decimal? @db.Decimal
  nstandakhir Decimal? @db.Decimal
  nvolume     Decimal? @db.Decimal
  nhargajual  Decimal? @db.Decimal
  nsubtotal   Decimal? @db.Decimal
  ckdbbm      String?  @db.Char(5)
  ckdtangki   String?  @db.Char(5)
  vcopeator   String?
  dtgljam     DateTime @db.Timestamptz()
  subah       Int?     @db.SmallInt
  sedit       Int?     @db.SmallInt
  ingestedAt  DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@unique([unitId, ckdjualbbm, ckdnozzle, nurut])
  @@index([unitId, dtgljam])
  @@map("sales_detail")
  @@schema("public")
}

model CashHeader {
  unitId     Int      @map("unit_id") @db.SmallInt
  ckdkb      String   @db.Char(15)
  dtgl       DateTime @db.Date
  vcket      String?
  sjnstrans  Int?     @db.SmallInt
  ntotal     Decimal? @db.Decimal
  vcref      String?
  ctmpkas    String?
  sbatal     Int?     @db.SmallInt
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([unitId, ckdkb])
  @@index([unitId, dtgl])
  @@map("cash_header")
  @@schema("public")
}

model CashDetail {
  id         BigInt   @id @default(autoincrement())
  unitId     Int      @map("unit_id") @db.SmallInt
  ckdkb      String   @db.Char(15)
  ckdperk    String?  @db.Char(8)
  njumlah    Decimal? @db.Decimal
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@unique([unitId, ckdkb, ckdperk])
  @@map("cash_detail")
  @@schema("public")
}

model Opname {
  id          BigInt    @id @default(autoincrement())
  unitId      Int       @map("unit_id") @db.SmallInt
  ckdopnbbm   String    @db.Char(15)
  ckdtangki   String    @db.Char(5)
  ckdbbm      String?   @db.Char(5)
  dtaglopn    DateTime? @db.Date
  nstockbk    Decimal?  @db.Decimal
  nstockop    Decimal?  @db.Decimal
  nvolselisih Decimal?  @db.Decimal
  dtgljam     DateTime  @db.Timestamptz()
  sbatal      Int?      @db.SmallInt
  ingestedAt  DateTime  @default(now()) @map("ingested_at") @db.Timestamptz()

  @@unique([unitId, ckdopnbbm, ckdtangki])
  @@index([unitId, dtgljam])
  @@map("opname")
  @@schema("public")
}

// Penebusan DO — header (tr_htebus). UPSERT by (unit_id, ckdtbs). Watermark
// DTGLTBS (date). Basis kolom "Penebusan DO" + running-balance DO Awal/Sisa.
model TebusHeader {
  unitId     Int      @map("unit_id") @db.SmallInt
  ckdtbs     String   @db.Char(15)
  dtgltbs    DateTime @db.Date
  cnoso      String?  @db.Char(20)
  sbatal     Int?     @db.SmallInt
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([unitId, ckdtbs])
  @@index([unitId, dtgltbs])
  @@map("tebus_header")
  @@schema("public")
}

// Penebusan DO — detail per produk (tr_dtebus). Grain (unit_id, ckdtbs, ckdbbm).
// NSISA = kolom mati (=NVOLUME) → tak di-sync. Surrogate id + unique utk UPSERT.
model TebusDetail {
  id         BigInt   @id @default(autoincrement())
  unitId     Int      @map("unit_id") @db.SmallInt
  ckdtbs     String   @db.Char(15)
  ckdbbm     String?  @db.Char(5)
  nvolume    Decimal? @db.Decimal
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@unique([unitId, ckdtbs, ckdbbm])
  @@map("tebus_detail")
  @@schema("public")
}

// Tera/kalibrasi nozzle (tabel EasyMax `tera`). Sumber kolom "Tera (L)" +
// komponen Penjualan_BERSIH (jual KOTOR − tera) di Gain/Losses harian. Watermark
// TanggalJam (datetime). Surrogate id + UNIQUE (unit_id, tanggaljam, no_nozzle)
// → idempoten saat re-pull window. ckdbbm di-resolve di agent (join MySQL ke
// tm_tangki/tm_bbm by name). Identifier mentah (no_nozzle/id_pompa/sa_tangki)
// disimpan untuk audit + kunci unik.
model Tera {
  id           BigInt   @id @default(autoincrement())
  unitId       Int      @map("unit_id") @db.SmallInt
  businessDate DateTime @map("business_date") @db.Date
  tanggaljam   DateTime @db.Timestamptz()
  noNozzle     String?  @map("no_nozzle") @db.VarChar(4)
  idPompa      Int?     @map("id_pompa") @db.SmallInt
  saTangki     Int?     @map("sa_tangki") @db.SmallInt
  jenis        Int?     @db.SmallInt
  ckdbbm       String?  @db.Char(5)
  liter        Decimal? @db.Decimal
  total        Decimal? @db.Decimal
  ingestedAt   DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@unique([unitId, tanggaljam, noNozzle])
  @@index([unitId, businessDate])
  @@map("tera")
  @@schema("public")
}

// Tera RESMI (ledger EasyMax tr_hterra ⋈ tr_dterra). SUMBER TUNGGAL angka terra
// laporan: Rincian B + seksi TERRA + kolom "Tera (L)" Laporan + net-sales G/L
// (gross − Σ nvolume). business_date = DTGLTERRA (= DTGLJUAL jurnal tertaut).
// Full-sync agent; UPSERT by natural key (unit_id, ckdterra, ckdnozzle). Filter
// laporan sbatal=0. BEDA dari `tera` (log mentah), yang tak lagi dipakai laporan.
model TerraResmi {
  unitId       Int      @map("unit_id") @db.SmallInt
  businessDate DateTime @map("business_date") @db.Date
  ckdterra     String   @db.VarChar(15)
  ckdnozzle    String   @db.VarChar(5)
  nshift       Int?     @db.SmallInt
  ckdtangki    String?  @db.Char(5)
  ckdbbm       String?  @db.Char(5)
  nvolume      Decimal? @db.Decimal
  nharga       Decimal? @db.Decimal
  ntotal       Decimal? @db.Decimal
  dtgljam      DateTime @db.Timestamptz()
  ckdjualbbm   String?  @db.VarChar(15)
  sbatal       Int?     @db.SmallInt
  ingestedAt   DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([unitId, ckdterra, ckdnozzle])
  @@index([unitId, businessDate])
  @@map("terra_resmi")
  @@schema("public")
}

model Delivery {
  unitId      Int       @map("unit_id") @db.SmallInt
  ckdtrm      String    @db.Char(15)
  dtgltrm     DateTime? @db.Date
  dtgljam     DateTime  @db.Timestamptz()
  cnodo       String?
  cnoso       String?   @db.Char(20)
  nvoldo      Decimal?  @db.Decimal
  nvolreal    Decimal?  @db.Decimal
  nvolselisih Decimal?  @db.Decimal
  cnopol      String?
  vcsopir     String?
  ckdtangki   String?   @db.Char(5)
  ckdbbm      String?   @db.Char(5)
  sbatal      Int?      @db.SmallInt
  ingestedAt  DateTime  @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([unitId, ckdtrm])
  @@index([unitId, dtgljam])
  @@map("delivery")
  @@schema("public")
}

model RealTank {
  unitId      Int      @map("unit_id") @db.SmallInt
  ckdtangki   String   @db.Char(5)
  nkapasitas  Decimal? @db.Decimal
  ntinggi     Decimal? @db.Decimal
  nvolume     Decimal? @db.Decimal
  nsuhu       Decimal? @db.Decimal
  ntinggiair  Decimal? @db.Decimal
  nvolumeair  Decimal? @db.Decimal
  nstatus     Int?     @db.SmallInt
  dtanggaljam DateTime @db.Timestamptz()
  ingestedAt  DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([unitId, ckdtangki])
  @@map("real_tank")
  @@schema("public")
}

model Product {
  unitId   Int      @map("unit_id") @db.SmallInt
  ckdbbm   String   @db.Char(5)
  vcnmbbm  String?
  nhrgjual Decimal? @db.Decimal
  perkMap  Json?    @map("perk_map")

  @@id([unitId, ckdbbm])
  @@map("product")
  @@schema("public")
}

model Nozzle {
  unitId    Int     @map("unit_id") @db.SmallInt
  ckdnozzle String  @db.Char(5)
  ckdpompa  String? @db.Char(5)
  ckdtangki String? @db.Char(5)

  @@id([unitId, ckdnozzle])
  @@map("nozzle")
  @@schema("public")
}

model Tangki {
  unitId     Int     @map("unit_id") @db.SmallInt
  ckdtangki  String  @db.Char(5)
  ckdbbm     String? @db.Char(5)
  vcnmtangki String?

  @@id([unitId, ckdtangki])
  @@map("tangki")
  @@schema("public")
}

model Account {
  unitId   Int     @map("unit_id") @db.SmallInt
  ckdperk  String  @db.Char(8)
  vcnmperk String?
  ckdinduk String? @db.Char(8)

  @@id([unitId, ckdperk])
  @@map("account")
  @@schema("public")
}

// --- Rincian Penjualan (FASE 1b) — sumber TERKUNCI by probe (ADR-001) ---

// Deposit prabayar pelanggan (tr_deposit). UPSERT by (unit_id, ckddepo); full-sync agent.
model Deposit {
  unitId     Int      @map("unit_id") @db.SmallInt
  ckddepo    String   @db.Char(15)
  dtgl       DateTime @db.Date
  ckdplg     String?  @db.VarChar(12)
  ntotal     Decimal? @db.Decimal
  nsaldo     Decimal? @db.Decimal
  sbatal     Int?     @db.SmallInt
  vcket      String?
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([unitId, ckddepo])
  @@index([unitId, dtgl])
  @@map("deposit")
  @@schema("public")
}

// EDC/non-tunai (vw_edc3). Surrogate id; REPLACE per (unit_id, business_date).
// ckdkartu null = blank-card (tak terklasifikasi; di-flag di dashboard).
model Edc {
  id           BigInt   @id @default(autoincrement())
  unitId       Int      @map("unit_id") @db.SmallInt
  businessDate DateTime @map("business_date") @db.Date
  cshift       String?  @db.VarChar(1)
  tanggaljam   DateTime @db.Timestamptz()
  ckdkartu     String?  @db.Char(5)
  total        Decimal? @db.Decimal
  liter        Decimal? @db.Decimal
  jenis        Int?     @db.SmallInt
  cnotrace     String?  @db.VarChar(20)
  nonozle      String?  @db.VarChar(4)
  jrnkey       Int?
  ingestedAt   DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  // Kunci natural anti-kembar (idempotensi REPLACE bersamaan). Index FISIK dibuat
  // migrasi 0012 dengan NULLS NOT DISTINCT (ckdkartu/cnotrace sering NULL utk
  // blank-card; Prisma 5.x belum bisa mengekspresikan NULLS NOT DISTINCT → @@unique
  // di sini hanya model logis, drift NULLS sengaja & terdokumentasi). Nama index
  // SAMA → ON CONFLICT (sql.ts buildReplace) menginfer index ini.
  @@unique([unitId, businessDate, cshift, tanggaljam, nonozle, cnotrace, ckdkartu, total], map: "edc_natural_key")
  @@index([unitId, businessDate])
  @@map("edc")
  @@schema("public")
}

// Penjualan tempo pelanggan (vw_jualplg). Surrogate id; REPLACE per business_date.
model PelangganSale {
  id           BigInt   @id @default(autoincrement())
  unitId       Int      @map("unit_id") @db.SmallInt
  businessDate DateTime @map("business_date") @db.Date
  ckdplg       String?  @db.VarChar(12)
  vcnmplg      String?
  ckdjualplg   String?  @db.Char(15)
  ckdbbm       String?  @db.VarChar(5)
  nshift       Int?     @db.SmallInt
  liter        Decimal? @db.Decimal
  total        Decimal? @db.Decimal
  sbatal       Int?     @db.SmallInt
  ingestedAt   DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@index([unitId, businessDate])
  @@map("pelanggan_sale")
  @@schema("public")
}

// Penjualan voucher pelanggan (vw_usevouc). Surrogate id; REPLACE per business_date.
model VoucherSale {
  id           BigInt   @id @default(autoincrement())
  unitId       Int      @map("unit_id") @db.SmallInt
  businessDate DateTime @map("business_date") @db.Date
  ckdplg       String?  @db.VarChar(12)
  vcnmplg      String?
  ckdusevouc   String?  @db.Char(15)
  ckdbbm       String?  @db.VarChar(5)
  nshift       Int?     @db.SmallInt
  liter        Decimal? @db.Decimal
  total        Decimal? @db.Decimal
  sbatal       Int?     @db.SmallInt
  ingestedAt   DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@index([unitId, businessDate])
  @@map("voucher_sale")
  @@schema("public")
}

// Master kartu/channel EDC (tm_card). PK (unit_id, ckdcard); full-sync.
model Card {
  unitId   Int     @map("unit_id") @db.SmallInt
  ckdcard  String  @db.Char(5)
  vcnmcard String?
  ckdbank  String? @db.Char(5)
  cgl      String? @db.VarChar(8)

  @@id([unitId, ckdcard])
  @@map("card")
  @@schema("public")
}

// Buku piutang pelanggan (tr_bppiut). Ledger; full-sync, UPSERT by (unit_id, ckdbppiut).
// Saldo Piutang = Σ njumlah·sign(sjnsbp:1=+,2=−), sbatal=0, dtgl<tanggal; split via
// pelanggan_master.sjenis (Lokal 1,5 · Online 3 · 4 dikecualikan).
model Bppiut {
  unitId     Int      @map("unit_id") @db.SmallInt
  ckdbppiut  String   @db.Char(15)
  dtgl       DateTime @db.Date
  ckdplg     String?  @db.VarChar(12)
  vcref      String?  @db.VarChar(20)
  vcket      String?
  njumlah    Decimal? @db.Decimal
  sjnsbp     Int?     @db.SmallInt
  sbatal     Int?     @db.SmallInt
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([unitId, ckdbppiut])
  @@index([unitId, dtgl])
  @@index([unitId, ckdplg])
  @@map("bppiut")
  @@schema("public")
}

// Buku hutang pelanggan (tr_bphut). Ledger; full-sync, UPSERT by (unit_id, ckdbphut).
// Saldo Hutang Lokal = −Σ njumlah·sign(sjnsbp:2=+,1=−), sbatal=0, dtgl<tanggal.
model Bphut {
  unitId     Int      @map("unit_id") @db.SmallInt
  ckdbphut   String   @db.Char(15)
  dtgl       DateTime @db.Date
  ckdplg     String?  @db.VarChar(12)
  vcref      String?  @db.VarChar(20)
  vcket      String?
  njumlah    Decimal? @db.Decimal
  sjnsbp     Int?     @db.SmallInt
  sbatal     Int?     @db.SmallInt
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz()

  @@id([unitId, ckdbphut])
  @@index([unitId, dtgl])
  @@map("bphut")
  @@schema("public")
}

// Master pelanggan AR (tm_plg). PK (unit_id, ckdplg); full-sync. `sjenis` =
// diskriminator Lokal/Online utk Saldo Piutang. (Tabel `pelanggan` = kartu RFID.)
model PelangganMaster {
  unitId  Int     @map("unit_id") @db.SmallInt
  ckdplg  String  @db.Char(12)
  vcnmplg String?
  sjenis  Int?    @db.SmallInt
  saktif  Int?    @db.SmallInt

  @@id([unitId, ckdplg])
  @@map("pelanggan_master")
  @@schema("public")
}

// ===========================================================================
// Schema `app` — auth (Auth.js v5 / @auth/pg-adapter) + RBAC multi-tenant.
// Tabel Auth.js dipetakan VERBATIM sesuai DDL adapter (id serial int, kolom
// camelCase ber-quote, TANPA FK/unique tambahan) demi NOL DRIFT. FK & integritas
// hanya di tabel milik kita (tenant/membership/user_unit). Lihat AUTH-RBAC-DESIGN.md.
// ===========================================================================

/// Auth.js: identitas user (dikelola adapter). JANGAN ubah nama kolom/tipe.
model User {
  id            Int       @id @default(autoincrement())
  name          String?   @db.VarChar(255)
  email         String?   @db.VarChar(255)
  emailVerified DateTime? @map("emailVerified") @db.Timestamptz()
  image         String?

  memberships Membership[] // relasi milik kita (FK di sisi membership)
  userRole    UserRole?

  @@map("users")
  @@schema("app")
}

/// Auth.js: akun OAuth tertaut (Google). Verbatim adapter.
model AuthAccount {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("userId")
  type              String  @db.VarChar(255)
  provider          String  @db.VarChar(255)
  providerAccountId String  @map("providerAccountId") @db.VarChar(255)
  refresh_token     String?
  access_token      String?
  expires_at        BigInt?
  id_token          String?
  scope             String?
  session_state     String?
  token_type        String?

  @@map("accounts")
  @@schema("app")
}

/// Auth.js: sesi DB (revocation seketika). Verbatim adapter.
model AuthSession {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("userId")
  expires      DateTime @db.Timestamptz()
  sessionToken String   @map("sessionToken") @db.VarChar(255)

  @@map("sessions")
  @@schema("app")
}

/// Auth.js: token verifikasi. Verbatim adapter (PK gabungan, tanpa id).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz()

  @@id([identifier, token])
  @@map("verification_token")
  @@schema("app")
}

/// Perusahaan (multi-tenant). Pilot: 1 baris (SolaGroup).
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  memberships Membership[]
  units       Unit[]

  @@map("tenant")
  @@schema("app")
}

/// OTORISASI: user ⇒ tenant + role. tenant_id NULL = super_admin (lintas-tenant).
model Membership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         Int      @map("user_id")
  tenantId       String?  @map("tenant_id") @db.Uuid
  role           String // super_admin | admin_perusahaan | direksi | keuangan | pengawas  (CHECK di 0032)
  status         String   @default("active") // active | invited | disabled
  /// true = semua unit tenant ini (unit BARU ikut otomatis); false = hanya daftar
  /// di user_unit (beku). Himpunan kosong TIDAK PERNAH berarti "semua" (0019).
  allUnits       Boolean  @default(false) @map("all_units")
  invitedByEmail String?  @map("invited_by_email")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units  UserUnit[]

  /// Unique-nya NULLS NOT DISTINCT di SQL (0019) — Prisma belum memodelkannya, jadi
  /// baris ini model LOGIS; drift disengaja & terdokumentasi (pola model Edc).
  @@unique([userId, tenantId])
  /// Target FK komposit dari app.user_unit (0019).
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("membership")
  @@schema("app")
}

/// Scope unit utk pengawas (direksi/admin = semua unit tenant → tanpa baris).
// Manual-entry pengawas (Pendapatan Lain / Pengeluaran). Identitas = id uuid;
// `urut` ordering biasa (BUKAN bagian unique). Audit void: voided_by + voided_at.
/// Daur hidup transaksi sumber (§2.2). `closed` hanya dipasang oleh day_close.
enum ManualEntryStatus {
  draft
  submitted
  returned
  closed

  @@map("manual_entry_status")
  @@schema("app")
}

enum ManualEntrySection {
  pendapatan_lain
  pengeluaran
  setoran_tunai

  @@map("manual_entry_section")
  @@schema("app")
}

model ManualEntry {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId          Int                @map("unit_id") @db.SmallInt
  businessDate    DateTime           @map("business_date") @db.Date
  section         ManualEntrySection
  urut            Int                @default(0)
  keterangan      String
  amount          Decimal            @db.Decimal(17, 2)
  void            Boolean            @default(false)
  createdByUserId Int                @map("created_by_user_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz()
  voidedByUserId  Int?               @map("voided_by_user_id")
  voidedAt        DateTime?          @map("voided_at") @db.Timestamptz()

  /// Milik PENGAWAS (§2.1). NULL = belum berkategori — JANGAN diturunkan dari
  /// `keterangan`; itu menebak milik orang lain. Wajib menyusul mode transisi.
  operationalCategory String?           @map("operational_category")
  /// Milik FINANCE. Diisi dari category_account_map saat submit lalu BEKU;
  /// akun efektif = reclassification non-void terakhir bila ada.
  accountingAccount   String?           @map("accounting_account")
  /// Backfill `submitted`, BUKAN `closed` — immutabilitas tidak dipasang mundur.
  status              ManualEntryStatus @default(submitted)
  submittedAt         DateTime?         @map("submitted_at") @db.Timestamptz()
  reviewedByUserId    Int?              @map("reviewed_by_user_id")
  reviewedAt          DateTime?         @map("reviewed_at") @db.Timestamptz()
  returnedReason      String?           @map("returned_reason")
  /// Pintu masuk baris ini (0034): `pengawas` (Rincian Penjualan) atau
  /// `finance`. FAKTA SAAT PENULISAN — jangan pernah menurunkannya dari peran
  /// `createdByUserId` saat dibaca: peran orang berubah, dan sejarah tidak
  /// boleh ikut berubah. CHECK di DB membatasi nilainya ke dua itu.
  sourceDoor          String            @default("pengawas") @map("source_door")

  @@index([unitId, businessDate, status])
  @@index([unitId, businessDate, section])
  @@map("manual_entry")
  @@schema("app")
}

// Harga beli BBM per (unit, produk, BERLAKU-SEJAK) — input manual, keputusan
// owner final (KEUANGAN-HARIAN.md §4.1 & §10). Harga JUAL tidak pernah diketik.
// Bukan deret harian: harga pada tanggal D = baris non-void dgn effective_from
// terbesar yang ≤ D. VOID-only + audit. Kolom p1_* = jejak penjaga "harga beli >
// harga jual" (PERINGATAN wajib-diakui, bukan reject) — kelengkapannya ditegakkan
// CHECK di migrasi 0020, kejujuran flag-nya oleh `harga-beli.ts` + tesnya.
model PurchasePrice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId           Int       @map("unit_id") @db.SmallInt
  productKey       String    @map("product_key")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  price            Decimal   @db.Decimal(14, 4)
  sourceNote       String?   @map("source_note")
  p1Triggered      Boolean   @default(false) @map("p1_triggered")
  /// Harga jual EasyMax saat keputusan diambil; selisih = price − p1SellPrice.
  p1SellPrice      Decimal?  @map("p1_sell_price") @db.Decimal(14, 4)
  p1AcknowledgedBy Int?      @map("p1_acknowledged_by")
  p1AcknowledgedAt DateTime? @map("p1_acknowledged_at") @db.Timestamptz()
  p1Reason         String?   @map("p1_reason")
  void             Boolean   @default(false)
  createdByUserId  Int       @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  voidedByUserId   Int?      @map("voided_by_user_id")
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz()

  @@index([unitId, productKey, effectiveFrom])
  @@map("purchase_price")
  @@schema("app")
}

// Reklasifikasi CoA (KEUANGAN-HARIAN §4.4). APPEND-ONLY: dashboard_app hanya
// SELECT+INSERT, UPDATE/DELETE di-REVOKE (0021). Tidak pernah menyentuh baris
// transaksi asli — nominal, tanggal, dan operational_category tetap milik
// pengawas. `sourceKind`/`sourceTxnId` sengaja TANPA FK: taksonomi transaksi
// yang boleh direklasifikasi belum diputuskan owner.
model Reclassification {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId          Int      @map("unit_id") @db.SmallInt
  sourceKind      String   @map("source_kind")
  sourceTxnId     String   @map("source_txn_id") @db.Uuid
  fromAccount     String   @map("from_account")
  toAccount       String   @map("to_account")
  reasonCode      String   @map("reason_code")
  note            String?
  createdByUserId Int      @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([sourceKind, sourceTxnId, createdAt])
  @@index([unitId, reasonCode, createdAt])
  @@map("reclassification")
  @@schema("app")
}

// Koreksi / pembalik setelah hari ditutup (KEUANGAN-HARIAN §4.5) dengan TUJUH
// field audit. APPEND-ONLY. `submitted_by <> approved_by` ditegakkan CHECK di
// DB (0021) — bukan di aplikasi: approver yang sama dengan pengaju membuat
// seluruh tangga wewenang §3.2 jadi hiasan.
model CorrectionEntry {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId            Int      @map("unit_id") @db.SmallInt
  sourceKind        String   @map("source_kind")
  originalTxnId     String   @map("original_txn_id") @db.Uuid
  reasonCode        String   @map("reason_code")
  valueBefore       Decimal  @map("value_before") @db.Decimal(17, 2)
  valueAfter        Decimal  @map("value_after") @db.Decimal(17, 2)
  submittedByUserId Int      @map("submitted_by_user_id")
  approvedByUserId  Int      @map("approved_by_user_id")
  approvedAt        DateTime @map("approved_at") @db.Timestamptz()
  evidenceRef       String?  @map("evidence_ref")
  /// 'reversal' | 'corrected_entry' (CHECK di 0021).
  kind              String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([sourceKind, originalTxnId, createdAt])
  @@index([unitId, reasonCode, createdAt])
  @@map("correction_entry")
  @@schema("app")
}

// Master sebab-selisih — DAFTAR TERTUTUP (B2, §10.2). 19 kode di-seed migrasi
// 0022. dashboard_app hanya SELECT: menambah kode = migrasi = keputusan owner.
// Tanpa unit_id ⇒ tanpa RLS, disengaja (master rujukan, bukan data per-unit).
model ReasonCode {
  code               String  @id
  label              String
  /// 'closing' | 'adjustment' | 'reclass' (CHECK di 0022).
  appliesTo          String  @map("applies_to")
  /// CLS-INVESTIGATING = true. Penegakannya menyusul bersama day_close.
  requiresTargetDate Boolean @default(false) @map("requires_target_date")
  active             Boolean @default(true)

  /// Target FK KOMPOSIT dari app.day_close (0026): mengunci bayangan
  /// requires_target_date supaya tak bisa menyimpang dari masternya.
  @@unique([code, requiresTargetDate])
  /// Target FK KOMPOSIT dari app.backdate_override (0027): hanya kode
  /// ber-applies_to='adjustment' yang boleh membenarkan backdate.
  @@unique([code, appliesTo])
  @@map("reason_code")
  @@schema("app")
}

// Pemetaan kategori operasional → CoA (B1 seragam + B3, §10.1/§10.3).
// unit_id NULL = berlaku semua unit; 14 baris seed seluruhnya default.
// Baris ber-unit menuntut `override_reason` (CHECK 0023) supaya tak bisa masuk
// tanpa disengaja, dan tetap butuh gerbang owner.
model CategoryAccountMap {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId              Int?     @map("unit_id") @db.SmallInt
  operationalCategory String   @map("operational_category")
  accountingAccount   String   @map("accounting_account")
  effectiveFrom       DateTime @map("effective_from") @db.Date
  overrideReason      String?  @map("override_reason")
  createdByUserId     Int?     @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([operationalCategory, effectiveFrom])
  @@map("category_account_map")
  @@schema("app")
}

/// Status penutupan hari (§4.6). `closed` mengunci manual_entry hari itu.
enum DayCloseStatus {
  open
  closed

  @@map("day_close_status")
  @@schema("app")
}

/// Tangga toleransi §3.2. TIER ADALAH FUNGSI dari difference_rp — ditegakkan
/// CHECK di 0026, bukan dipilih bebas.
enum DayCloseTier {
  within_tolerance
  exception_hof
  override_direksi

  @@map("day_close_tier")
  @@schema("app")
}

// GERBANG PENUTUPAN HARI (§3.2 + §4.6). difference_rp = LANGKAH HARIAN
// BSCheck(d) − BSCheck(d−1), disimpan APA ADANYA (tidak dibulatkan, tidak
// dinolkan, termasuk yang ≤ Rp 10.000). `reasonRequiresTarget` adalah bayangan
// reason_code.requires_target_date yang dikunci FK KOMPOSIT — itulah yang
// membuat CHECK tanggal-target membaca DATA, bukan menghardcode nama kode.
model DayClose {
  unitId       Int            @map("unit_id") @db.SmallInt
  businessDate DateTime       @map("business_date") @db.Date
  status       DayCloseStatus @default(open)
  differenceRp Decimal        @map("difference_rp") @db.Decimal(17, 2)
  tier         DayCloseTier

  reasonCode           String?   @map("reason_code")
  reasonRequiresTarget Boolean?  @map("reason_requires_target")
  targetDate           DateTime? @map("target_date") @db.Date

  closedByUserId   Int?      @map("closed_by_user_id")
  closedAt         DateTime? @map("closed_at") @db.Timestamptz()
  approvedByUserId Int?      @map("approved_by_user_id")
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@id([unitId, businessDate])
  @@index([unitId, status, businessDate])
  @@map("day_close")
  @@schema("app")
}

// JALUR TEMBUS backdate ke hari yang sudah ditutup (keputusan owner 13 Agu 2026,
// §2.2). SEKALI PAKAI: dikonsumsi trigger 0027 begitu satu INSERT lolos, dan
// `consumedByEntryId` mencatat entri mana yang ia izinkan. Override yang MENETAP
// membuka hari itu selamanya — itu kegagalan paling mahal di jalur ini.
// ⚠️ DB tidak bisa menegakkan bahwa approver memenuhi canCloseException
// (keanggotaan HoF ada di ENV); itu dijaga `keuangan-override.ts`.
model BackdateOverride {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId            Int       @map("unit_id") @db.SmallInt
  businessDate      DateTime  @map("business_date") @db.Date
  reasonCode        String    @map("reason_code")
  /// Bayangan reason_code.applies_to, dikunci FK komposit + CHECK = 'adjustment'.
  reasonAppliesTo   String    @map("reason_applies_to")
  alasan            String
  requestedByUserId Int       @map("requested_by_user_id")
  approvedByUserId  Int?      @map("approved_by_user_id")
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz()
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz()
  consumedByEntryId String?   @map("consumed_by_entry_id") @db.Uuid
  void              Boolean   @default(false)
  voidedByUserId    Int?      @map("voided_by_user_id")
  voidedAt          DateTime? @map("voided_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([unitId, businessDate, createdAt])
  @@map("backdate_override")
  @@schema("app")
}

// Penandaan SO MACET oleh Finance (B6, §10.6). SOValue = sisa − sisa_macet.
// ⛔ MANUAL: tidak ada ambang di sini, dan tak ada baris yang lahir sendiri —
// ambang hari hanya MENGUSULKAN kandidat. `cnoso` disimpan ter-normalisasi
// (lower+trim) sebab tautan CNOSO di repo ini case-insensitive.
model SoMacet {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId         Int       @map("unit_id") @db.SmallInt
  cnoso          String
  ckdbbm         String
  alasan         String
  markedByUserId Int       @map("marked_by_user_id")
  markedAt       DateTime  @default(now()) @map("marked_at") @db.Timestamptz()
  void           Boolean   @default(false)
  voidedByUserId Int?      @map("voided_by_user_id")
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz()

  @@index([unitId])
  @@map("so_macet")
  @@schema("app")
}

/// Jenis akun kas (§1.3). Tujuh akun Bakau: 1 kas · 1 EDC penampungan · 5 bank.
enum CashAccountKind {
  kas
  bank
  edc_penampungan

  @@map("cash_account_kind")
  @@schema("app")
}

enum CashMutationSide {
  debet
  kredit

  @@map("cash_mutation_side")
  @@schema("app")
}

enum CashMutationJenis {
  debet
  kredit
  adjustment

  @@map("cash_mutation_jenis")
  @@schema("app")
}

// Akun kas — DATA, bukan enum (rekening bertambah/ditutup; 4 dari 5 bank Bakau
// dorman 2–5 tahun, §7.7). Penutupan = active=false + closed_at, TANPA DELETE:
// mutasi lama harus tetap menunjuk akun yang benar.
model CashAccount {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId    Int             @map("unit_id") @db.SmallInt
  nama      String
  kind      CashAccountKind
  active    Boolean         @default(true)
  openedAt  DateTime?       @map("opened_at") @db.Date
  closedAt  DateTime?       @map("closed_at") @db.Date
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([unitId, nama])
  /// Target FK komposit dari app.cash_ledger (0029): mengunci mutasi ke akun
  /// milik unit yang SAMA — RLS pada ledger tak bisa menangkap salah-unit ini.
  @@unique([id, unitId])
  @@map("cash_account")
  @@schema("app")
}

// Kategori mutasi debet/kredit — daftar TERTUTUP (workbook List!Q & List!S),
// disiplin sama dgn reason_code: dashboard_app hanya SELECT. Kunci alaminya
// (side, label) sebab tiga label muncul di KEDUA sisi.
model CashMutationCategory {
  side   CashMutationSide
  label  String
  active Boolean          @default(true)

  @@id([side, label])
  @@map("cash_mutation_category")
  @@schema("app")
}

// Mutasi kas/bank. ⛔ TIDAK ada kolom saldo — saldo adalah TURUNAN (Σ amount).
// Workbook menyimpan Saldo Akhir per baris, dan itulah yang membuat satu
// sisipan di tengah mendiamkan seluruh kolom di bawahnya.
// Nominal BERTANDA: debet > 0, kredit < 0 (CHECK di 0029).
model CashLedger {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId              Int               @map("unit_id") @db.SmallInt
  accountId           String            @map("account_id") @db.Uuid
  businessDate        DateTime          @map("business_date") @db.Date
  keterangan          String
  jenis               CashMutationJenis
  categorySide        CashMutationSide? @map("category_side")
  categoryLabel       String?           @map("category_label")
  amount              Decimal           @db.Decimal(17, 2)
  /// §10.24 — PENANDA, bukan angka: titik awal rekening. Satu per akun (indeks parsial 0036).
  saldoAwal           Boolean           @default(false) @map("saldo_awal")
  void                Boolean           @default(false)
  createdByUserId     Int               @map("created_by_user_id")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  voidedByUserId      Int?              @map("voided_by_user_id")
  voidedAt            DateTime?         @map("voided_at") @db.Timestamptz()
  // Tautan ke settlement EDC yang melahirkan baris ini (0030). NULL untuk
  // mutasi biasa. Kolomnya sudah ada di DB sejak 0030 tetapi belum pernah
  // tercermin di sini — drift lama, dirapikan bersama 0033.
  edcSettlementId     String?           @map("edc_settlement_id") @db.Uuid
  // Tautan ke setoran pengawas yang DITAWARKAN dan disetujui (0033). Indeks
  // unik parsial di DB memastikan satu setoran = paling banyak satu baris aktif.
  sourceManualEntryId String?           @map("source_manual_entry_id") @db.Uuid

  @@index([unitId, accountId, businessDate])
  @@index([unitId, categorySide, categoryLabel, businessDate])
  @@map("cash_ledger")
  @@schema("app")
}

// Batch settlement EDC (§10.5). EDC Penampungan = akun kliring RIIL yang cair
// H+1, MDR dipotong DI MUKA. `mdrRp` dan `selisihRp` adalah kolom GENERATED —
// tidak pernah diketik. Jurnal pencairannya DITAWARKAN, bukan diposting:
// `postedBy/At` adalah jejak PERSETUJUAN, bukan penanda otomatis.
model EdcSettlement {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId          Int       @map("unit_id") @db.SmallInt
  acquirer        String
  settlementNo    String    @map("settlement_no")
  settlementDate  DateTime  @map("settlement_date") @db.Date
  businessDate    DateTime  @map("business_date") @db.Date
  toAccountId     String    @map("to_account_id") @db.Uuid
  grossRp         Decimal   @map("gross_rp") @db.Decimal(17, 2)
  netRp           Decimal   @map("net_rp") @db.Decimal(17, 2)
  /// GENERATED gross − net. Jangan pernah ditulis aplikasi.
  mdrRp           Decimal?  @map("mdr_rp") @db.Decimal(17, 2)
  txnTotalRp      Decimal?  @map("txn_total_rp") @db.Decimal(17, 2)
  /// GENERATED txn_total − gross.
  selisihRp       Decimal?  @map("selisih_rp") @db.Decimal(17, 2)
  reasonCode      String?   @map("reason_code")
  reasonAppliesTo String?   @map("reason_applies_to")
  postedByUserId  Int?      @map("posted_by_user_id")
  postedAt        DateTime? @map("posted_at") @db.Timestamptz()
  void            Boolean   @default(false)
  voidedByUserId  Int?      @map("voided_by_user_id")
  voidedAt        DateTime? @map("voided_at") @db.Timestamptz()
  createdByUserId Int       @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([unitId, acquirer, settlementDate])
  @@map("edc_settlement")
  @@schema("app")
}

// Beban NON-KAS turunan-mesin (§2.5, keputusan owner 13 Agu 2026). Kaki ketiga
// jurnal pencairan EDC: Beban MDR 7-1200, yang BUKAN akun kas sehingga tak
// punya tempat di cash_ledger.
// ⛔ SENGAJA TANPA `operationalCategory` — bukan NULL karena "belum diisi",
// melainkan karena kolom itu TIDAK BERLAKU: tak ada pengawas yang memilikinya.
// Kalau kolomnya tidak ada, tak ada yang bisa salah mengisinya.
// MESIN menghitung, MANUSIA menyetujui: `postedByUserId` NOT NULL.
model NoncashExpense {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId            Int       @map("unit_id") @db.SmallInt
  businessDate      DateTime  @map("business_date") @db.Date
  accountingAccount String    @map("accounting_account")
  amountRp          Decimal   @map("amount_rp") @db.Decimal(17, 2)
  keterangan        String
  /// NOT NULL: 7-1200 harus SELALU bisa ditelusuri ke selisih bruto−neto.
  edcSettlementId   String    @map("edc_settlement_id") @db.Uuid
  postedByUserId    Int       @map("posted_by_user_id")
  postedAt          DateTime  @default(now()) @map("posted_at") @db.Timestamptz()
  void              Boolean   @default(false)
  voidedByUserId    Int?      @map("voided_by_user_id")
  voidedAt          DateTime? @map("voided_at") @db.Timestamptz()

  @@index([unitId, businessDate, accountingAccount])
  @@map("noncash_expense")
  @@schema("app")
}

// Usulan Penebusan SO (input pengawas → Keuangan). 3 kolom manual per produk per
// tanggal; "awal hari" (Sisa Stock/DO) TIDAK disimpan (carry-forward D−1 dihitung
// ulang di dashboard). VOID-only + audit. `status` draft→diajukan (informasional,
// pengawas-driven). Satu baris aktif per (unit,tanggal,produk) — partial unique.
model UsulanSo {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId          Int       @map("unit_id") @db.SmallInt
  businessDate    DateTime  @map("business_date") @db.Date
  productKey      String    @map("product_key")
  penerimaanHari  Decimal   @default(0) @map("penerimaan_hari") @db.Decimal(14, 2)
  permintaanBesok Decimal   @default(0) @map("permintaan_besok") @db.Decimal(14, 2)
  usulanPenebusan Decimal   @default(0) @map("usulan_penebusan") @db.Decimal(14, 2)
  status          String    @default("draft")
  void            Boolean   @default(false)
  createdByUserId Int       @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  voidedByUserId  Int?      @map("voided_by_user_id")
  voidedAt        DateTime? @map("voided_at") @db.Timestamptz()

  @@index([unitId, businessDate])
  @@map("usulan_so")
  @@schema("app")
}

/// INVARIAN "satu role per orang" (0019), DEKLARATIF. Tepat satu baris per user
/// (PK user_id); membership.(user_id, role) ber-FK komposit ke sini, sehingga semua
/// membership seseorang WAJIB berbagi role yang sama. Ubah role = satu UPDATE di
/// sini + ON UPDATE CASCADE. Bukan trigger: trigger prosedural & tak terlihat di \d.
model UserRole {
  userId Int    @id @map("user_id")
  role   String // super_admin | admin_perusahaan | direksi | keuangan | pengawas  (CHECK di 0032)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_role")
  @@schema("app")
}

model UserUnit {
  membershipId String @map("membership_id") @db.Uuid
  unitId       Int    @map("unit_id") @db.SmallInt
  /// Turunan dari membership; ada semata agar FK KOMPOSIT ke DUA sisi
  /// ((unit_id,tenant_id)->unit dan (membership_id,tenant_id)->membership) bisa
  /// mengunci keselarasan unit<->tenant SECARA STRUKTURAL (0019). Di SQL kedua FK
  /// itu komposit; di sini relasinya tetap tunggal (model LOGIS, drift disengaja)
  /// karena backend tidak pernah menulis tabel ini — dashboard memakai `pg` mentah.
  tenantId     String @map("tenant_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [unitId], onDelete: Cascade)

  @@id([membershipId, unitId])
  @@map("user_unit")
  @@schema("app")
}

/// Jejak audit append-only untuk aksi /admin (grant/revoke akses). Migration 0017.
/// dashboard_app: SELECT+INSERT saja (UPDATE/DELETE dicabut → tak bisa ditulis-ulang).
model AuditLog {
  /// Tenant yang disentuh aksi ini (0019). NULL = aksi global ⇒ hanya terlihat
  /// super_admin (fail-closed untuk pembaca admin terdelegasi).
  tenantId String? @map("tenant_id") @db.Uuid

  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId Int      @map("actor_user_id")
  actorEmail  String?  @map("actor_email")
  action      String
  target      String?
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([createdAt])
  @@index([action])
  @@map("audit_log")
  @@schema("app")
}

// Saldo pelanggan Fase 1 (0037/0038). Builder memakai SQL mentah, tetapi model
// tetap dicatat agar schema.prisma menjadi inventaris lengkap tabel aplikasi.
model SaldoPelangganSourceCycle {
  unitId                 Int       @map("unit_id") @db.SmallInt
  sourceCycleId          String    @map("source_cycle_id") @db.Uuid
  sourceCycleSequence    BigInt    @map("source_cycle_sequence")
  previousSourceCycleId  String?   @map("previous_source_cycle_id") @db.Uuid
  status                 String    @default("staging")
  startedAt              DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  sourceCompletedAt      DateTime? @map("source_completed_at") @db.Timestamptz()
  promotedAt             DateTime? @map("promoted_at") @db.Timestamptz()
  failedAt               DateTime? @map("failed_at") @db.Timestamptz()
  pelangganRowCount      BigInt?   @map("pelanggan_row_count")
  pelangganKeyedChecksum Bytes?    @map("pelanggan_keyed_checksum")
  bppiutRowCount         BigInt?   @map("bppiut_row_count")
  bppiutKeyedChecksum    Bytes?    @map("bppiut_keyed_checksum")
  bphutRowCount          BigInt?   @map("bphut_row_count")
  bphutKeyedChecksum     Bytes?    @map("bphut_keyed_checksum")
  failureSummary         String?   @map("failure_summary")

  @@id([unitId, sourceCycleId], map: "sps_cycle_pkey")
  @@unique([unitId, sourceCycleId, sourceCycleSequence], map: "sps_cycle_unit_id_sequence_key")
  @@unique([unitId, sourceCycleId, sourceCycleSequence, status], map: "sps_cycle_complete_target_key")
  @@unique([unitId, sourceCycleSequence], map: "sps_cycle_unit_sequence_key")
  @@map("saldo_pelanggan_source_cycle")
  @@schema("app")
}

model SaldoPelangganSourcePelanggan {
